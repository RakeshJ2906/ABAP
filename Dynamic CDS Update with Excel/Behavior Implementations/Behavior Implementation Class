CLASS lhc_ZI_DM_COCKPIT DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS get_instance_features FOR INSTANCE FEATURES
      keys REQUEST requested_features FOR zi_dm_cockpit RESULT result.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      keys REQUEST requested_authorizations FOR zi_dm_cockpit RESULT result.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      REQUEST requested_authorizations FOR zi_dm_cockpit RESULT result.

    METHODS downloadTemplate FOR MODIFY
       keys FOR ACTION zi_dm_cockpit~downloadTemplate RESULT result.

    METHODS updateObject FOR MODIFY
       keys FOR ACTION zi_dm_cockpit~updateObject RESULT result.


    CLASS-METHODS get_dynamic_template
      IMPORTING iv_entity_name    TYPE string
      RETURNING VALUE(rv_content) TYPE xstring.

    CLASS-METHODS parse_to_table
      IMPORTING
        iv_xstring       TYPE xstring
        iv_filename      TYPE string
        io_struct_descr  TYPE REF TO cl_abap_structdescr
      EXPORTING
        et_dynamic_table TYPE STANDARD TABLE.

ENDCLASS.

CLASS lhc_ZI_DM_COCKPIT IMPLEMENTATION.

  METHOD get_instance_features.
  ENDMETHOD.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD get_global_authorizations.
  ENDMETHOD.

  METHOD downloadTemplate.

    READ TABLE keys INTO DATA(ls_input) INDEX 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    DATA(lv_object) = CONV string( keys[ 1 ]-BusinessObject ).

    DATA(lv_file_content) = lhc_zi_dm_cockpit=>get_dynamic_template( lv_object ).

    MODIFY ENTITIES OF zi_dm_cockpit IN LOCAL MODE
    ENTITY zi_dm_cockpit
    UPDATE FROM VALUE #( FOR ls_key IN keys
                         ( %tky = ls_key-%tky
                           Template = lv_file_content
                           Filename   = |{ lv_object }_template.xlsx|   "'template.xlsx'
                           Mimetype   = 'application/vnd.ms-excel'
                           %control-Template  = if_abap_behv=>mk-on
                           %control-Filename   = if_abap_behv=>mk-on
                           %control-Mimetype  = if_abap_behv=>mk-on ) )
    MAPPED DATA(ls_mapped_update)
    REPORTED DATA(ls_reported_update)
    FAILED DATA(ls_failed_update).

    READ ENTITIES OF zi_dm_cockpit IN LOCAL MODE
    ENTITY zi_dm_cockpit
    ALL FIELDS WITH CORRESPONDING #( keys )
    RESULT DATA(lt_updated_data).

    result = VALUE #( FOR ls_data IN lt_updated_data
                      ( %tky = ls_data-%tky
                        %param = ls_data ) ).

  ENDMETHOD.

  METHOD updateObject.

    DATA: lv_generic TYPE abap_bool VALUE 'X'.

    READ ENTITIES OF zi_dm_cockpit IN LOCAL MODE
    ENTITY zi_dm_cockpit
    ALL FIELDS WITH CORRESPONDING #( keys )
    RESULT DATA(lt_bo_data).

    READ TABLE lt_bo_data INDEX 1 INTO DATA(ls_bo_data).
    IF sy-subrc IS INITIAL.
      DATA(lv_cds_entity) = to_upper( CONV string( ls_bo_data-BusinessObject ) ).
    ELSE.
      RETURN.
    ENDIF.

    IF lv_generic = abap_true.

      " 2. Dynamically resolve the CDS entity structure using RTTI
      DATA: lr_table_data TYPE REF TO data.
      FIELD-SYMBOLS: <lt_dynamic_table> TYPE STANDARD TABLE.

      TRY.
          " Describe the structure type of the CDS Entity directly
          cl_abap_typedescr=>describe_by_name(
            EXPORTING
              p_name         = lv_cds_entity
            RECEIVING
              p_descr_ref    = DATA(lo_type_descr) ).

          " Ensure it's a structure/view type before proceeding
          IF lo_type_descr->kind <> cl_abap_typedescr=>kind_struct.
            " Handle error: Not a valid structure/entity
          ENDIF.

          " Create a dynamic standard internal table based on the entity descriptor
          DATA(lo_struct_descr) = CAST cl_abap_structdescr( lo_type_descr ).
          CREATE DATA lr_table_data TYPE STANDARD TABLE OF (lv_cds_entity).
          ASSIGN lr_table_data->* TO <lt_dynamic_table>.

        CATCH cx_root INTO DATA(lx_rtti_error).
          " Handle error: Entity does not exist or cannot be generated dynamically
      ENDTRY.

      " 3. Parse the Excel binary content using Field Symbols
      " The parser will match Excel header column names to components of <lt_dynamic_table>
      lhc_zi_dm_cockpit=>parse_to_table(
        EXPORTING
          iv_xstring   = ls_bo_data-Attachment
          iv_filename = CONV string( ls_bo_data-Filename )
          io_struct_descr = lo_struct_descr
        IMPORTING
          et_dynamic_table    = <lt_dynamic_table>
      ).


      DATA: lr_create_tab TYPE REF TO data,
            lr_line       TYPE REF TO data.

      FIELD-SYMBOLS: <lt_create> TYPE STANDARD TABLE,
                     <ls_line>   TYPE any.

      " lv_cds holds e.g. 'ZI_CDS_ENTITY'
      " Use the absolute type name for BDEF derived type if needed,
      " or create a standard table of the CDS structure dynamically
      CREATE DATA lr_create_tab TYPE TABLE OF (lv_cds_entity).
      ASSIGN lr_create_tab->* TO <lt_create>.

      CREATE DATA lr_line TYPE (lv_cds_entity).
      ASSIGN lr_line->* TO <ls_line>.

      "Dynamic Processing
      DATA: lt_create_so_details TYPE TABLE FOR CREATE zrj_i_tkt_info.

      LOOP AT <lt_dynamic_table> ASSIGNING FIELD-SYMBOL(<ls_raw_details>).
        APPEND INITIAL LINE TO lt_create_so_details ASSIGNING FIELD-SYMBOL(<ls_upd_details>).
        TRY.
            <ls_upd_details>-%cid = cl_system_uuid=>create_uuid_x16_static( ).
          CATCH cx_uuid_error.
            "handle exception
        ENDTRY.
        MOVE-CORRESPONDING <ls_raw_details> TO <ls_upd_details>.

        "Fill %CONTROL structure dynamically
        DATA(lo_structdescr) = CAST cl_abap_structdescr( cl_abap_typedescr=>describe_by_data( <ls_upd_details> ) ).
        ASSIGN COMPONENT '%CONTROL' OF STRUCTURE <ls_upd_details> TO FIELD-SYMBOL(<fs_control>).
        LOOP AT lo_structdescr->components INTO DATA(ls_component).
          "to skip technical components
          CHECK ls_component-name NP '%*'.
          ASSIGN COMPONENT ls_component-name OF STRUCTURE <ls_upd_details> TO FIELD-SYMBOL(<lv_field>).
          IF <lv_field> IS ASSIGNED AND <lv_field> IS NOT INITIAL.
            ASSIGN COMPONENT ls_component-name OF STRUCTURE <fs_control> TO FIELD-SYMBOL(<lv_ctrl_fld>).
            IF <lv_ctrl_fld> IS ASSIGNED.
              <lv_ctrl_fld> = if_abap_behv=>mk-on.
            ENDIF.
          ENDIF.
        ENDLOOP.

      ENDLOOP.

      DATA: lt_op_tab TYPE abp_behv_changes_tab.

      lt_op_tab = VALUE #( ( op = if_abap_behv=>op-m-create
                             entity_name = lv_cds_entity
                             instances = REF #( lt_create_so_details )  ) ).

      MODIFY ENTITIES OPERATIONS lt_op_tab
       MAPPED   DATA(lt_mapped_dyn)
       FAILED   DATA(lt_failed_dyn)
       REPORTED DATA(lt_reported_dyn).

    ELSE.

      CASE lv_cds_entity.

        WHEN 'ZRJ_I_TKT_INFO'.
          DATA: lt_raw_bo_details TYPE STANDARD TABLE OF zrj_i_tkt_info,
                lt_upd_bo_details TYPE TABLE FOR CREATE zrj_i_tkt_info.

          cl_abap_typedescr=>describe_by_name( EXPORTING p_name = lv_cds_entity RECEIVING p_descr_ref = DATA(lo_desc_so) ).

          lhc_zi_dm_cockpit=>parse_to_table(
            EXPORTING
              iv_xstring   = ls_bo_data-Attachment
              iv_filename = CONV string( ls_bo_data-Filename )
              io_struct_descr = CAST #( lo_desc_so )
           IMPORTING
              et_dynamic_table    = lt_raw_bo_details ).

          LOOP AT lt_raw_bo_details ASSIGNING FIELD-SYMBOL(<ls_raw_bo_details>).
            APPEND INITIAL LINE TO lt_upd_bo_details ASSIGNING FIELD-SYMBOL(<ls_upd_bo_details>).
            TRY.
                <ls_upd_bo_details>-%cid = cl_system_uuid=>create_uuid_x16_static( ).
              CATCH cx_uuid_error.
                "handle exception
            ENDTRY.
            MOVE-CORRESPONDING <ls_raw_bo_details> TO <ls_upd_bo_details>.

            " Cleanly flag the %control attributes checked by your upload template
            <ls_upd_bo_details>-%control-TicketId  = if_abap_behv=>mk-on.
            <ls_upd_bo_details>-%control-Priority = if_abap_behv=>mk-on.
            <ls_upd_bo_details>-%control-Category = if_abap_behv=>mk-on.
            <ls_upd_bo_details>-%control-FullDescription = if_abap_behv=>mk-on.
          ENDLOOP.

          IF lt_upd_bo_details IS NOT INITIAL.
            MODIFY ENTITIES OF zrj_i_tkt_info
              ENTITY TicketInfo
              CREATE FROM lt_upd_bo_details
              FAILED DATA(ls_failed_cust) REPORTED DATA(ls_reported_cust).

            " NOTE FOR FUTURE ASSOCIATIONS:
            " update a child entity via association here later:
            " MODIFY ENTITIES OF zi_customer_view IN LOCAL MODE
            "   ENTITY ZI_Customer_View CREATE BY \_CustomerItems FIELDS ( ... ) WITH lt_cba_data...
          ENDIF.
      ENDCASE.

    ENDIF.

    READ ENTITIES OF zi_dm_cockpit IN LOCAL MODE
    ENTITY zi_dm_cockpit
    ALL FIELDS WITH CORRESPONDING #( keys )
    RESULT DATA(lt_updated_data).

    result = VALUE #( FOR ls_data IN lt_updated_data
                      ( %tky = ls_data-%tky
                        %param = ls_data ) ).


  ENDMETHOD.

  METHOD get_dynamic_template.

    DATA: lt_components TYPE cl_abap_structdescr=>component_table.
    DATA: lvc_fname TYPE c LENGTH 30.

    "Read Components from entity
    DATA(lo_struct) = CAST cl_abap_structdescr( cl_abap_typedescr=>describe_by_name( iv_entity_name ) ).
    LOOP AT lo_struct->get_components( ) INTO DATA(ls_comp).
      IF ls_comp-name = 'CREATEDBY'
      OR ls_comp-name = 'CREATEDAT'
      OR ls_comp-name = 'LASTCHANGEDBY'
      OR ls_comp-name = 'LASTCHANGEDAT'
      OR ls_comp-name = 'LOCALLASTCHANGEDAT'.
        CONTINUE.
      ENDIF.
      APPEND ls_comp TO lt_components.
    ENDLOOP.

    "Create Dynamic structure
    DATA(lo_filtered_struct) = cl_abap_structdescr=>create( lt_components ).
    DATA(lo_table_descr) = cl_abap_tabledescr=>create( p_line_type = lo_filtered_struct
                                                       p_table_kind = cl_abap_tabledescr=>tablekind_std
                                                       p_unique = abap_false ).

    "Create Dynamic table
    DATA lr_table TYPE REF TO data.
    CREATE DATA lr_table TYPE HANDLE lo_table_descr.
    ASSIGN lr_table->* TO FIELD-SYMBOL(<lt_data>).

    "Instantiate SALV table in memory
    DATA lo_salv TYPE REF TO cl_salv_table.
    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = lo_salv
                                CHANGING t_table = <lt_data> ).
      CATCH cx_salv_msg.
        "handle exception
    ENDTRY.

    "Assign header labels
    DATA(lo_columns) = lo_salv->get_columns( ).
    LOOP AT lt_components INTO ls_comp.
      TRY.
          DATA(lo_column) = lo_columns->get_column( CONV lvc_fname( ls_comp-name ) ).
          DATA(lv_text_s) = CONV scrtext_s( ls_comp-name ).
          DATA(lv_text_m) = CONV scrtext_m( ls_comp-name ).
          DATA(lv_text_l) = CONV scrtext_l( ls_comp-name ).

          lo_column->set_short_text( lv_text_s  ).
          lo_column->set_medium_text( lv_text_m ).
          lo_column->set_long_text( lv_text_l ).
        CATCH cx_salv_not_found.
          CONTINUE.
      ENDTRY.
    ENDLOOP.

    "Convert into OpenXML (".XLSX") byte stream
    rv_content = lo_salv->to_xml( xml_type = if_salv_bs_xml=>c_type_xlsx ).

  ENDMETHOD.

  METHOD parse_to_table.

    DATA: lo_excel           TYPE REF TO cl_fdt_xl_spreadsheet,
          lt_worksheet_names TYPE string_table,
          lr_excel_data      TYPE REF TO data.

    FIELD-SYMBOLS: <lt_excel_data>   TYPE STANDARD TABLE,
                   <ls_excel_row>    TYPE any,
                   <ls_target_row>   TYPE any,
                   <lv_source_field> TYPE any,
                   <lv_target_field> TYPE any.

    CLEAR et_dynamic_table.

    TRY.
        " Instantiate the spreadsheet using the raw binary stream and filename
        lo_excel = NEW cl_fdt_xl_spreadsheet(
          document_name = iv_filename
          xdocument       = iv_xstring
        ).

        lo_excel->if_fdt_doc_spreadsheet~get_worksheet_names( IMPORTING worksheet_names = lt_worksheet_names ).
        READ TABLE lt_worksheet_names INTO DATA(lv_first_sheet) INDEX 1.

        IF sy-subrc = 0.
          lr_excel_data = lo_excel->if_fdt_doc_spreadsheet~get_itab_from_worksheet( lv_first_sheet ).
          ASSIGN lr_excel_data->* TO <lt_excel_data>.
        ENDIF.

      CATCH cx_root.
        RETURN. " Parsing failure, return initial table
    ENDTRY.

    IF <lt_excel_data> IS NOT ASSIGNED OR <lt_excel_data> IS INITIAL.
      RETURN.
    ENDIF.

    " Read the header row (Row 1)
    READ TABLE <lt_excel_data> ASSIGNING FIELD-SYMBOL(<ls_header_row>) INDEX 1.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    " Loop through the data rows starting from Row 2
    LOOP AT <lt_excel_data> ASSIGNING <ls_excel_row> FROM 2.
      APPEND INITIAL LINE TO et_dynamic_table ASSIGNING <ls_target_row>.
      DATA(lv_col_index) = 1.
      " Dynamically loop through every column field inside the row structure
      DO.
        " 1. Read the header cell name for the current column index
        ASSIGN COMPONENT lv_col_index OF STRUCTURE <ls_header_row> TO FIELD-SYMBOL(<lv_header_cell>).
        IF sy-subrc <> 0.
          EXIT. " Exit the DO loop when there are no more columns left in the row
        ENDIF.

        IF <lv_header_cell> IS NOT INITIAL.
          DATA(lv_clean_header) = to_upper( condense( CONV string( <lv_header_cell> ) ) ).
          " 2. Check if this header matches a field name in the target CDS structure
          READ TABLE io_struct_descr->components WITH KEY name = lv_clean_header TRANSPORTING NO FIELDS.
          IF sy-subrc = 0.
            " 3. Read the actual data cell value for this column
            ASSIGN COMPONENT lv_col_index OF STRUCTURE <ls_excel_row> TO FIELD-SYMBOL(<lv_excel_value>).
            IF sy-subrc = 0 AND <lv_excel_value> IS ASSIGNED AND <lv_excel_value> IS NOT INITIAL.
              " 4. Map the value directly to the target row component
              ASSIGN COMPONENT lv_clean_header OF STRUCTURE <ls_target_row> TO <lv_target_field>.
              IF sy-subrc = 0.
                <lv_target_field> = <lv_excel_value>.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
        lv_col_index = lv_col_index + 1.
      ENDDO.
    ENDLOOP.

  ENDMETHOD.

ENDCLASS.
